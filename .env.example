# ------------------------------------------------------------
# INÍCIO SEGURO
# ------------------------------------------------------------
PORT=3210
TIMEZONE=America/Sao_Paulo
DATA_WORKBOOK=./data/campanha.xlsx
ACTIVE_CLIENTS_FILE=./data/clientes-ativos.json
STATE_FILE=./data/state.json
LEAD_SEED_FILE=./data/leads-rfb-2026-07-12.json
SEND_MODE=dry-run
DOMAIN_AUTH_CONFIRMED=false

# ------------------------------------------------------------
# IDENTIDADE DO REMETENTE
# ------------------------------------------------------------
SENDER_NAME=Parts Seals
SENDER_EMAIL=vendas@parts-seals.com.br
SENDER_PHONE=(19) 3626-3552 | (19) 98301-1817
SENDER_SITE=https://parts-seals.com.br
REPLY_TO=vendas@parts-seals.com.br
BROCHURE_FILE=./output/pdf/apresentacao-comercial-parts-seals.pdf

# ------------------------------------------------------------
# SMTP - PREENCHA COM O PROVEDOR DA CAIXA DE E-MAIL
# Exemplos comuns: porta 587 + secure=false ou porta 465 + secure=true
# ------------------------------------------------------------
# Coloque a senha da caixa de e-mail na linha SMTP_PASS abaixo.
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vendas@parts-seals.com.br
SMTP_PASS=
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_BASE_DELAY_MS=1000

# ------------------------------------------------------------
# IMAP - OPCIONAL, MAS RECOMENDADO PARA PARAR FOLLOW-UPS
# QUANDO HOUVER RESPOSTA, REMOÇÃO OU DEVOLUÇÃO
# ------------------------------------------------------------
IMAP_ENABLED=true
IMAP_HOST=email-ssl.com.br
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=vendas@parts-seals.com.br
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_SENT_MAILBOX=INBOX.enviadas
REQUIRE_SENT_COPY=true

# ------------------------------------------------------------
# AGENDA AUTOMÁTICA
# Duas janelas por dia útil, no fuso definido em TIMEZONE.
# ------------------------------------------------------------
AUTO_BATCH_SIZE=12
AUTO_BATCH_INTERVAL_MINUTES=15
AUTO_BATCH_WINDOWS=09:30-10:30,14:00-15:00
AUTO_BATCH_WEEKDAYS_ONLY=true
AUTO_BATCH_MAX_PER_DAY=120
AUTO_BATCH_MAX_PER_HOUR=60

# ------------------------------------------------------------
# LIMITES PARA ENVIO MANUAL / PILOTO
# ------------------------------------------------------------
MAX_PER_DAY=20
MAX_PER_HOUR=5
MIN_INTERVAL_MINUTES=8
BUSINESS_START=08:00
BUSINESS_END=17:00
FOLLOWUP1_BUSINESS_DAYS=4
FOLLOWUP2_BUSINESS_DAYS=9

# ------------------------------------------------------------
# AUTENTICAÇÃO DO DOMÍNIO
# Informe o seletor DKIM usado pelo seu provedor para o verificador DNS.
# ------------------------------------------------------------
DKIM_SELECTOR=

# ------------------------------------------------------------
# SUPABASE - BANCO DE DADOS ONLINE
# Preencha somente no .env real. Nunca publique a Secret Key.
# ------------------------------------------------------------
DATA_BACKEND=supabase
SUPABASE_URL=https://frcmigvbuzhxbdxwvvna.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZFQIFaCNHMZT4u3r3zl7VQ_HuPqu7ff
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------
# LOGIN DO PAINEL
# A senha abaixo cria o primeiro administrador no primeiro login.
# No Netlify, marque INITIAL_ADMIN_PASSWORD como segredo.
# Após criar o Admin e trocar sua senha pelo painel, remova esta variável.
# ------------------------------------------------------------
INITIAL_ADMIN_USERNAME=Admin
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------
# PESQUISA WEB COM IA - OPCIONAL
# Sem chave, o restante do sistema continua funcionando normalmente.
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
